// World scale parameters (D11). Values here are the design defaults the performance budgets are
// measured at; see WorldConfig in crates/vx_core/src/config.rs for each supported range. Missing
// fields take the design default. The planet, its terrain and its atmosphere are in system.ron.
(
    // Edge length of one level 0 voxel in metres; level L voxels are 2^L times larger.
    // Design default 1.0, supported 0.25 to 4.0.
    voxel_size_m: 1.0,
    // World seed (D5): every generated value is a pure function of position and this seed.
    seed: 1,
    // Levels of the planet octree (D20); level 7 chunks are 4,096 m at 1 m voxels. Supported 4 to 14.
    lod_levels: 8,
    // A node splits within this many of its own chunk extents of the camera. Supported 2 to 16.
    lod_radius_chunks: 4.0,
    // Extra extents before a split node merges again. Supported 0 to 4.
    lod_hysteresis_chunks: 1.0,
    // The render origin rebases beyond this distance from the camera (D23). Supported 1000 to 16000.
    origin_rebase_m: 4000.0,
)
